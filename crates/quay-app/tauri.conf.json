{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quay",
  "version": "0.1.0",
  "identifier": "dev.quay.desktop",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../apps/desktop run dev",
    "beforeBuildCommand": "npm --prefix ../../apps/desktop run build"
  },
  "app": {
    "windows": [
      {
        "title": "Quay",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
